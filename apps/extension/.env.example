# Copy to `.env` and adjust, then `npm run build`. This is the ONE place the
# server/dashboard address lives — it feeds both the in-page fetches (config.js)
# and the manifest's host_permissions (manifest.config.js). Default is local dev.
# The extension does not send X-API-Key; keep the server's API_KEY unset for a
# direct connection, or point this URL at a trusted intermediary that injects it.
VITE_SERVER_URL=http://localhost:3456
